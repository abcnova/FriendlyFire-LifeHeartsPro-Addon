<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.abcnova</groupId>
  <artifactId>friendlyfire-lhp-addon</artifactId>
  <version>1.2.0</version>
  <name>FriendlyFire LHP Addon</name>
  <description>Per-team friendly-fire controls for LifeHeartsPro.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <api.group>org.spigotmc</api.group>
    <api.artifact>spigot-api</api.artifact>
    <api.version>1.21-R0.1-SNAPSHOT</api.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>spigotmc</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>${api.group}</groupId>
      <artifactId>${api.artifact}</artifactId>
      <version>${api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>plugin.yml</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>plugin.yml</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration><release>${maven.compiler.release}</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration><useModulePath>false</useModulePath></configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>spigot-26.3</id>
      <properties><api.version>26.3-R0.1-SNAPSHOT</api.version></properties>
    </profile>
    <profile>
      <id>paper-1.21</id>
      <properties>
        <api.group>io.papermc.paper</api.group>
        <api.artifact>paper-api</api.artifact>
        <api.version>1.21-R0.1-SNAPSHOT</api.version>
      </properties>
    </profile>
    <profile>
      <id>paper-26.3</id>
      <properties>
        <api.group>io.papermc.paper</api.group>
        <api.artifact>paper-api</api.artifact>
        <api.version>26.3.build.207-stable</api.version>
      </properties>
    </profile>
  </profiles>
</project>
